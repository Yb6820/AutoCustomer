# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=autocustomer
DB_PASSWORD=change-me
DB_NAME=autocustomer
DB_POOL_SIZE=20
DB_POOL_OVERFLOW=10

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_BROKER=redis://localhost:6379/1
REDIS_CELERY_BACKEND=redis://localhost:6379/2

# ========== Milvus ==========
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=autocustomer

# ========== JWT ==========
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 加密 ==========
AES_ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string

# ========== LLM / Embedding ==========
LLM_DEFAULT_PROVIDER=openai_compat
LLM_DEFAULT_ENDPOINT=http://localhost:8000/v1
LLM_DEFAULT_API_KEY=change-me
LLM_DEFAULT_MODEL=qwen2.5-7b

EMBEDDING_PROVIDER=bge_m3
EMBEDDING_ENDPOINT=http://localhost:8001/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_DIM=1024

RERANK_ENDPOINT=http://localhost:8002/v1
RERANK_API_KEY=change-me

# ========== MinIO ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=autocustomer

# ========== 日志 ==========
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========== SSE Ticket ==========
SSE_TICKET_TTL_SECONDS=30